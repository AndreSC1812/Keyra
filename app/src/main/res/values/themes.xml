<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background avoids a white flash before Compose draws the first frame. -->
    <style name="Theme.Keyra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/keyra_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
