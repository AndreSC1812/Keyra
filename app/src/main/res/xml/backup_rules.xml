<?xml version="1.0" encoding="utf-8"?>
<!-- The vault is bound to this device's Keystore, so nothing is included in auto backup.
     Use the encrypted export from Settings instead. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
